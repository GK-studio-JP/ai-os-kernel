{
  "schema": "ai-os-process-registry:v1",
  "processes": [
    {
      "id": "PROC-KERNEL",
      "repository": "GK-studio-JP/ai-os-kernel",
      "capabilities": [
        "registry.read",
        "task.spawn",
        "context.read",
        "ipc.send",
        "event.publish",
        "state.commit"
      ]
    },
    {
      "id": "PROC-SCHEDULER",
      "repository": "GK-studio-JP/ai-os-scheduler",
      "capabilities": [
        "context.read",
        "ipc.send",
        "event.publish"
      ]
    },
    {
      "id": "PROC-CONTEXT",
      "repository": "GK-studio-JP/ai-os-context",
      "capabilities": [
        "context.read",
        "event.publish"
      ]
    },
    {
      "id": "PROC-RUNTIME",
      "repository": "GK-studio-JP/ai-os-runtime",
      "capabilities": [
        "context.read",
        "ipc.send",
        "event.publish"
      ],
      "routing": {
        "target_mode": "registered-process-repository"
      }
    },
    {
      "id": "PROC-RUNTIME-BROWSER-WORKER",
      "repository": "GK-studio-JP/ai-os-runtime-browser-worker",
      "capabilities": [
        "context.read",
        "ipc.send",
        "event.publish"
      ],
      "routing": {
        "target_mode": "registered-process-repository"
      }
    },
    {
      "id": "PROC-BULLETIN",
      "repository": "GK-studio-JP/ai-bulletin-board",
      "capabilities": [
        "context.read",
        "ipc.send",
        "event.publish",
        "state.commit"
      ]
    }
  ],
  "canonical_board": "GK-studio-JP/ai-bulletin-board"
}
